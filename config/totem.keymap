//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

&mt {
    quick-tap-ms = <200>;
    global-quick-tap;
    flavor = "hold-preferred";
    tapping-term-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        lbracecombo {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <2 3>;
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
        };

        lparcombo {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <12 13>;
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
        };

        lbracketcombo {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <23 24>;
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
        };

        rbracecombo {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <6 7>;
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
        };

        rparcombo {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <17 16>;
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
        };

        rbracketcombo {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <27 28>;
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
        };

        oneshot_mirror {
            bindings = <&sl 5>;
            key-positions = <32 33>;
            slow-release;
            layers = <0>;
            timeout-ms = <0>;
        };

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <13 16>;
        };

        Lessthancombo {
            bindings = <&kp LESS_THAN>;
            key-positions = <24 25>;
            require-prior-idle-ms = <50>;
            timeout-ms = <40>;
        };

        greaterthancombo {
            bindings = <&kp GREATER_THAN>;
            key-positions = <26 27>;
            require-prior-idle-ms = <50>;
            timeout-ms = <40>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <50>;
        };

        lh_pht: left_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;                        // <---[[produces tap if held longer than tapping-term-ms]]
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 9 15 16 18 19 26 27 28 29 30 31 36 37 17 35 36 13 12 11 10>;    // <---[[right-hand keys]]
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        rh_pht: rh_pht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            label = "RH_PHT";
            hold-trigger-key-positions = <16 17 18 19 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 32 33 34>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        qgt: qgt {
            compatible = "zmk,behavior-mod-morph";
            label = "q_to_gui_tab";
            bindings = <&kp Q>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        lesm: lt_enter_space_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "LT_ENTER_SPACE_MORPH";
            bindings = <&lt 2 RETURN>, <&lt 2 SPACE>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL)>;
            keep-mods = <(MOD_RCTL)>;
        };

        hm_shift: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <10>;
            label = "homerow_mods_shift";
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base {
            bindings = <
            &kp Q               &kp W               &kp E            &kp R               &kp T          &kp Y  &kp U              &kp I            &kp O               &kp P
            &lh_pht LEFT_GUI A  &lh_pht LEFT_ALT S  &lh_pht LCTRL D  &hm_shift LSHIFT F  &kp G          &kp H  &hm_shift RSHFT J  &rh_pht RCTRL K  &rh_pht LEFT_ALT L  &rh_pht LGUI SEMICOLON
&kp LSHIFT  &kp Z               &kp X               &kp C            &kp V               &kp B          &kp N  &kp M              &kp COMMA        &kp PERIOD          &kp SLASH               &mt RIGHT_SHIFT ENTER
                                                    &kp LCTRL        &kp BACKSPACE       &lt 3 SPACE    &lesm  &kp BACKSPACE      &kp LALT
            >;
        };

        colemak-dh {
            bindings = <
            &kp Q               &kp W               &kp F            &kp P               &kp B          &kp J  &kp L              &kp U            &kp Y               &kp SEMICOLON
            &lh_pht LEFT_GUI A  &lh_pht LEFT_ALT R  &lh_pht LCTRL S  &hm_shift LSHIFT T  &kp G          &kp M  &hm_shift RSHFT N  &rh_pht RCTRL E  &rh_pht LEFT_ALT I  &rh_pht LGUI O
&kp LSHIFT  &kp X               &kp C               &kp D            &kp V               &kp Z          &kp K  &kp H              &kp COMMA        &kp PERIOD          &kp SLASH       &mt RIGHT_SHIFT ENTER
                                                    &kp LCTRL        &kp BACKSPACE       &lt 3 SPACE    &lesm  &kp BACKSPACE      &kp LALT
            >;
        };

        nav_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "NAVI";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃           ┃           ┃     UP    ┃           ┃     {     ┃   ┃     }     ┃     7     ┃     8     ┃     9     ┃     +     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SHIFT   ┃   LEFT    ┃    DOWN   ┃   RIGHT   ┃     [     ┃   ┃     ]     ┃     4     ┃     5     ┃     6     ┃     -     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃   P UP    ┃  C LOCK   ┃  P DOWN   ┃     (     ┃   ┃     )     ┃     1     ┃     2     ┃     3     ┃     *     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    TAB    ┃    SPC    ┃   ┃    DEL    ┃     0     ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
         &kp ESC    &trans  &trans  &trans  &kp C_MUTE      &kp C_PP         &trans    &kp HOME      &kp END        &kp LS(LC(MINUS))
         &kp LSHFT  &trans  &trans  &trans  &kp C_PREV      &kp C_NEXT       &kp LEFT  &kp UP_ARROW  &kp DOWN       &kp RIGHT
&kp TAB  &kp DEL    &trans  &trans  &trans  &kp C_VOL_DN    &kp C_VOLUME_UP  &trans    &kp PAGE_UP   &kp PAGE_DOWN  &trans             &kp LC(LS(MINUS))
                            &trans  &trans  &mo 4           &trans           &trans    &trans
            >;
        };

        symbol_layer_numpad {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "SYM";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     !     ┃     @     ┃     #     ┃     $     ┃     %     ┃   ┃     ˆ     ┃     &     ┃     Ü     ┃     '     ┃     "     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     Ä     ┃           ┃    SZ     ┃           ┃           ┃   ┃   MUTE    ┃   YEN     ┃   EURO    ┃  POUND    ┃     Ö     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃  EMAIL1   ┃  EMAIL2   ┃           ┃           ┃           ┃   ┃   VOL-    ┃   VOL+    ┃   LAST    ┃   NEXT    ┃     \     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    GIF    ┃    ADJ    ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
       &kp GRAVE   &kp AT           &kp PERCENT   &kp DOUBLE_QUOTES  &kp PIPE    &kp AMPERSAND  &kp KP_N7        &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_EQUAL
       &kp DOLLAR  &kp EXCLAMATION  &kp QUESTION  &kp EQUAL          &kp PLUS    &kp MINUS      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp SQT
&sl 5  &kp CARET   &kp HASH         &kp DOLLAR    &kp UNDERSCORE     &kp STAR    &kp SLASH      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp BSLH      &kp RSHIFT
                                    &trans        &trans             &trans      &kp TAB        &kp GRAVE        &kp KP_NUMBER_0
            >;
        };

        adjust_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "ADJ";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃   RESET   ┃ BT CLEAR  ┃  OUT TOG  ┃           ┃           ┃   ┃           ┃    F7     ┃    F8     ┃    F9     ┃    F12    ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃ BOOTLOAD  ┃ BT NEXT   ┃           ┃           ┃           ┃   ┃           ┃    F4     ┃    F5     ┃    F6     ┃    F11    ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃ BT PREV   ┃           ┃           ┃           ┃   ┃           ┃    F1     ┃    F2     ┃    F3     ┃    F10    ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
       &sys_reset   &bt BT_CLR  &out OUT_TOG  &trans  &bt BT_SEL 0    &bt BT_SEL 1  &kp F7  &kp F8  &kp F9  &kp F12
       &bootloader  &bt BT_NXT  &trans        &trans  &trans          &trans        &kp F4  &kp F5  &kp F6  &kp F11
&to 1  &trans       &bt BT_PRV  &trans        &trans  &trans          &trans        &kp F1  &kp F2  &kp F3  &kp F10  &to 0
                                &trans        &trans  &trans          &trans        &trans  &trans
            >;
        };

        right_mirrored_on_left {
            bindings = <
        &kp P                &kp O           &kp I       &kp U        &kp Y     &trans  &trans  &trans  &trans  &trans
        &hm LCTRL SEMICOLON  &hm LEFT_ALT L  &hm LGUI K  &hm LSHFT J  &kp H     &trans  &trans  &trans  &trans  &trans
&trans  &kp FSLH             &kp DOT         &kp COMMA   &kp M        &kp N     &trans  &trans  &trans  &trans  &trans  &trans
                                             &trans      &trans       &trans    &trans  &trans  &trans
            >;
        };

        symbol_layer_numbers {
            label = "SYM_NUM";
            bindings = <
       &kp GRAVE   &kp EXCLAMATION  &kp PERCENT           &kp DOUBLE_QUOTES  &kp PIPE    &kp AMPERSAND  &kp KP_N7        &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_EQUAL
       &kp DOLLAR  &kp AT_SIGN      &kp LEFT_PARENTHESIS  &kp EQUAL          &kp PLUS    &kp MINUS      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp SQT
&sl 5  &kp CARET   &kp HASH         &kp LEFT_BRACKET      &kp UNDERSCORE     &kp STAR    &kp SLASH      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp BSLH      &kp RSHIFT
                                    &trans                &trans             &trans      &kp TAB        &kp GRAVE        &kp KP_NUMBER_0
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
    };
};
